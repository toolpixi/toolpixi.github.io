# Icon sprite (2026-11-03 speed pass): glyph paths are collected once into
# /assets/sprite.svg and each icon instance is a tiny <use> reference, instead
# of repeating the full path data in every page. Rendering is identical —
# the outer <svg> keeps the same attributes and the paths inherit its stroke.
_SPRITE = {}

def _sprite_id(paths):
    sid = 'i-' + hashlib.md5(paths.encode()).hexdigest()[:10]
    _SPRITE[sid] = paths
    return sid

def icon(glyph, fg):
    return ('<svg viewBox="0 0 24 24" fill="none" stroke="%s" stroke-width="2" '
            'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/assets/sprite.svg#%s"/></svg>'
            % (fg, _sprite_id(ICON_PATHS[glyph])))

