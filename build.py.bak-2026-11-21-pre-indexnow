def related_html(slugs, self_slug=None):
    # P2: expand each page's related list to up to 6 contextual in-body links —
    # closest same-category siblings fill any gaps — and give every link a
    # descriptive anchor (tool name + what it does), never a bare name alone.
    chosen = [s for s in slugs if s != self_slug]
    if chosen:
        cat = TOOL_BY_SLUG[chosen[0]][3]
        for t in TOOLS:
            if len(chosen) >= 6:
                break
            if t[3] == cat and t[0] not in chosen and t[0] != self_slug:
                chosen.append(t[0])
    out = []
    for s in chosen:
        t = TOOL_BY_SLUG[s]
        out.append('<a href="/%s/">%s — %s</a>' % (s, t[1], t[2]))
    return ('<section class="section"><h2>Related tools</h2><div class="related">' +
            "\n".join(out) + "</div></section>")

